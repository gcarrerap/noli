rules_version = '2';
// Reglas de Firestore del proyecto gcarrerap-noli, que es solo de Noli (#112). Antes Noli vivía en dominomx junto
// con La Pata y el dominó; ya no hay que copiar bloques de otras apps: publicar este archivo reemplaza todo y está bien.
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Noli (gcarrerap/noli, #7) ----
    // Administrador de Noli (admin.html): su cuenta de Google es la única que puede listar perfiles y ponerles nombre.
    function esAdminNoli() {
      return request.auth != null && request.auth.token.email == 'carrera.perabeles@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Perfil: su id es aleatorio de 24 caracteres y funciona como llave. Se puede leer con get (sabiendo el id),
    // nunca listar (salvo el administrador), así que nadie descubre perfiles ajenos.
    match /noli_perfiles/{perfil} {
      allow get, create: if request.auth != null && perfil.size() >= 20;
      allow list: if esAdminNoli();
      allow update: if esAdminNoli() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60;
      allow delete: if false;
      // Progreso por juego: { json (texto), actualizado (ms), dispositivo }
      match /juegos/{juego} {
        allow read: if request.auth != null && perfil.size() >= 20;
        allow write: if request.auth != null && perfil.size() >= 20
          && request.resource.data.json is string
          && request.resource.data.json.size() < 200000
          && request.resource.data.actualizado is number;
      }
    }
    // Códigos para vincular un dispositivo: 6 dígitos, duran 10 minutos. Se leen con get (no se pueden listar);
    // el dispositivo que ya tiene el perfil solo puede escribirle el perfil una vez.
    match /noli_vinculos/{codigo} {
      allow get, delete: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && codigo.matches('^[0-9]{6}$')
        && request.resource.data.perfil == null
        && request.resource.data.expira is number;
      // Crear de nuevo un código vencido (la TV pidió uno que coincidió con otro viejo)
      allow update: if request.auth != null && (
        (resource.data.perfil == null && request.resource.data.perfil is string
          && request.resource.data.perfil.size() >= 20
          && request.resource.data.expira == resource.data.expira
          && request.time.toMillis() < resource.data.expira)
        || (resource.data.expira < request.time.toMillis() && request.resource.data.perfil == null));
    }
    // ---- Noli: salas del control remoto (gcarrerap/noli, #3) ----
    // La TV abre la sala (su usuario anónimo queda en "tv") y la renueva cada minuto; el teléfono se une
    // escribiendo "control". Otra TV solo puede tomar el código cuando la sala ya se venció (campo "vence").
    match /noli_salas/{codigo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && codigo.matches('^[0-9]{4}$')
        && request.resource.data.codigo == codigo
        && request.resource.data.keys().hasOnly(['codigo', 'tv', 'sesion', 'creada', 'vence', 'tvVisto', 'control'])
        && ((resource == null && request.resource.data.tv == request.auth.uid)
          || request.resource.data.tv == resource.data.tv
          || (request.resource.data.tv == request.auth.uid && resource.data.vence < request.time.toMillis()));
      allow delete: if request.auth != null && resource.data.tv == request.auth.uid;
      // Mensajes para conectar el teléfono con la TV por WebRTC (quien los recibe los borra)
      match /senales/{id} {
        allow read, write: if request.auth != null;
      }
      // Respaldo cuando WebRTC no conecta: una acción del control por documento (la TV las borra al recibirlas)
      match /acciones/{id} {
        allow read, delete: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.accion in ['arriba', 'abajo', 'izquierda', 'derecha', 'ok', 'atras', 'brincar'];
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
